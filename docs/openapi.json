    "/api/auth/csrf": {
      "get": {
        "summary": "Obtener protección CSRF",
        "description": "Sin cuerpo. Conservar la cookie recibida. token y headerName; solicitar otra vez después del login/logout.",
        "operationId": "get_api_auth_csrf",
        "responses": {
          "200": {
            "description": "token y headerName; solicitar otra vez después del login/logout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Iniciar sesión",
        "description": "Formulario correo=analista@demo.local y password=Practica2026!. id, nombre, correo y rol; establece una cookie de sesión HttpOnly.",
        "operationId": "post_api_auth_login",
        "responses": {
          "200": {
            "description": "id, nombre, correo y rol; establece una cookie de sesión HttpOnly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Sesión o credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permiso o CSRF inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sesion": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "correo": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "correo",
                  "password"
                ]
              }
            }
          }
        }
      }
    },
