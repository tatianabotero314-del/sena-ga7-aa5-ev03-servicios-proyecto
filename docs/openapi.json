  "components": {
    "schemas": {
      "CandidatoInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipoDocumento": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "numeroDocumento": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "nombres": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "apellidos": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "correo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "format": "email"
          },
          "telefono": {
            "type": "string",
            "minLength": 1,
            "maxLength": 25
          }
        },
        "required": [
          "tipoDocumento",
          "numeroDocumento",
          "nombres",
          "apellidos",
          "correo",
          "telefono"
        ]
      },
      "PostulacionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idCandidato": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "idVacante": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "idCandidato",
          "idVacante"
        ]
      },
      "EstadoInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "En proceso",
              "Seleccionado",
              "Rechazado"
            ]
          },
          "observacion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "estado",
          "observacion"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "Candidato": {
        "type": "object",
        "properties": {
          "tipoDocumento": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "numeroDocumento": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "nombres": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "apellidos": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "correo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "format": "email"
          },
          "telefono": {
            "type": "string",
            "minLength": 1,
            "maxLength": 25
          },
          "id": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "tipoDocumento",
          "numeroDocumento",
          "nombres",
          "apellidos",
          "correo",
          "telefono",
          "id"
        ]
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nombre": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          },
          "rol": {
            "type": "string",
            "enum": [
              "Analista",
              "Coordinador"
            ]
          }
        },
        "required": [
          "id",
          "nombre",
          "correo",
          "rol"
        ]
      },
      "Csrf": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "headerName"
        ]
      },
      "Vacante": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "cargo": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
